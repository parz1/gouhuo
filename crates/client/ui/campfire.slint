// 篝火场景：固定镜头，一圈 8 块石头围着火，每块石头是频道里的一个人。
//
// 这个画面只有一个任务：**瞄一眼就知道谁在、谁在说话**。挂在后台打游戏的人
// 切出来只看一两秒，所以氛围永远让位给这两件事。
//
// 谁坐哪块石头、底图和石头的像素画，都是 Rust 那边画好的（src/campfire/）。
// 这里只管摆位置、把像素图不插值地放大、叠上字和状态。
//
// SeatGeometry comes from the Rust scene host; labels, hit areas and stones share it.

import { Theme } from "theme.slint";
import { CallTokens } from "call/tokens.slint";
import { CallButton } from "call/controls/button.slint";
import { ScrollView } from "std-widgets.slint";

/// 一个座位。模型固定 8 条，第 n 条就是 n 号座位 ——
/// 这样「点开的是谁」可以记座位号，有人进出时不会点着 A 变成 B。
export struct Seat {
    /// 这个位子上有没有人。空位也占一条。
    present: bool,
    id: int,
    name: string,
    /// 刻在石头上的那一个字。
    glyph: string,
    /// 石头形状和颜色的种子，按公钥算的：同一个人在谁那里看都是同一块石头。
    seed: int,
    /// 像素石头：平时的、说话时的（绿描边 + 一圈火光）。
    stone: image,
    stone-talking: image,
    muted: bool,
    deafened: bool,
    speaking: bool,
    is-me: bool,
    // 下面几个跟左边名单那一行一样，点开石头时用
    volume: int,
    role: int,
    can-kick: bool,
    can-ban: bool,
    can-set-role: bool,
}

component StoneSeat {
    in property <Seat> data;
    in property <bool> talking;
    /// 坐在火后面那半圈：名字写在石头上面，免得被火挡住。
    in property <bool> up;
    in property <length> s;
    callback clicked();
    in property <int> restore-id: -1;
    forward-focus: seat-focus;
    seat-focus := FocusScope {
        enabled: root.data.present && !root.data.is-me;
        key-pressed(event) => { if (event.text == " " || event.text == Key.Return) { root.clicked(); return accept; } return reject; }
    }
    changed restore-id => { if (root.restore-id == root.data.id && !root.data.is-me) { seat-focus.focus(); } }

    width: 90px;
    height: root.s + 24px;

    accessible-role: button;
    accessible-label: root.data.name
        + (root.data.is-me ? "（我）" : "")
        + (root.talking ? "，正在说话" : root.data.deafened ? "，关了耳朵" : root.data.muted ? "，闭麦" : "");
    accessible-action-default => { if (!root.data.is-me) { root.clicked(); } }

    stone := Rectangle {
        x: (parent.width - self.width) / 2;
        y: root.up ? 24px : 0;
        width: root.s * 1.45;
        height: root.s;
        opacity: root.data.deafened ? 0.5 : 1;

        // 像素图比石头本身每边多几格，放说话时的那圈光；居中放
        Image {
            source: root.talking ? root.data.stone-talking : root.data.stone;
            image-rendering: pixelated;
            width: self.source.width * 4px;
            height: self.source.height * 4px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }

        // 刻出来的字：下沿一道很淡的亮边
        Text {
            y: 1.2px;
            text: root.data.glyph;
            color: root.talking ? transparent : #ffffff17;
            font-size: root.s * 0.42;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }
        Text {
            text: root.data.glyph;
            color: root.talking ? #FFD166 : #101014b0;
            font-size: root.s * 0.42;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
        }

        if root.data.muted || root.data.deafened: Rectangle {
            width: root.s * 0.4;
            height: self.width;
            x: parent.width - self.width * 0.8;
            y: parent.height - self.height * 0.8;
            border-radius: self.width / 2;
            border-width: 2px;
            border-color: #0f1013;
            background: root.data.deafened ? Theme.danger : Theme.warn;
            Image {
                source: root.data.deafened ? @image-url("icons/ear-off.svg") : @image-url("icons/mic-off.svg");
                width: parent.width * 0.6;
                height: self.width;
            }
        }
    }

    Rectangle {
        y: root.up ? 0 : root.s + 4px;
        height: 20px;
        width: Math.min(label.preferred-width + 14px, parent.width);
        x: (parent.width - self.width) / 2;
        border-radius: 4px;
        background: #101114b8;
        label := Text {
            text: root.data.name + (root.data.is-me ? "（我）" : "");
            width: parent.width - 14px;
            color: root.talking ? #ffffff : (root.data.is-me ? CallTokens.warm : Theme.dim);
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }

    Rectangle { x: 0; y: 0; width: 100%; height: 100%; background: transparent; border-width: seat-focus.has-focus ? 2px : 0px; border-color: CallTokens.warm; border-radius: 6px; }

    TouchArea {
        // 点自己没有反应 —— 跟左边名单一样，自己的开关在左下角。
        enabled: !root.data.is-me;
        mouse-cursor: root.data.is-me ? default : pointer;
        clicked => { seat-focus.focus(); root.clicked(); }
    }
}


export struct SeatGeometry { x: float, y: float, size: float, up: bool }

export component Campfire inherits Rectangle {
    in property <[Seat]> seats;
    in property <[Seat]> waiting;
    in property <[SeatGeometry]> geometry;
    in property <bool> waiting-talking;
    in property <bool> transmitting;
    in property <bool> stale;
    in property <image> backdrop;
    in property <int> restore-member: -1;
    callback open-member(int);
    property <bool> list-open: false;
    background: #0f1013;
    clip: true;
    forward-focus: scene-keys;
    scene-keys := FocusScope {
        key-pressed(event) => { if (event.text == Key.Escape && root.list-open) { root.list-open = false; return accept; } return reject; }
        Image { x: 0; y: 0; width: 100%; height: 100%; source: root.backdrop; image-rendering: pixelated; image-fit: fill; accessible-role: none; }
        for seat[i] in root.seats: StoneSeat {
            visible: seat.present && i < root.geometry.length;
            data: seat;
            talking: !root.stale && (seat.is-me ? root.transmitting : seat.speaking);
            up: i < root.geometry.length && root.geometry[i].up;
            s: i < root.geometry.length ? root.geometry[i].size * 1px : 34px;
            x: i < root.geometry.length ? root.geometry[i].x * 1px - self.width / 2 : 0px;
            y: i < root.geometry.length ? root.geometry[i].y * 1px - root.geometry[i].size * 0.5px - (self.up ? 24px : 0px) : 0px;
            restore-id: root.restore-member;
            clicked => { root.open-member(seat.id); }
        }
        if root.waiting.length > 0: CallButton {
            x: parent.width - self.width - 10px;
            y: 4px;
            width: 92px;
            height: parent.height < 200px ? 24px : 32px;
            label: "还有 " + root.waiting.length + " 人";
            accessible-label: "还有 " + root.waiting.length + " 人" + (!root.stale && root.waiting-talking ? "，其中有人在说话" : "");
            if !root.stale && root.waiting-talking: Rectangle { x: parent.width - 8px; y: 3px; width: 5px; height: 5px; border-radius: 3px; background: CallTokens.speaking; }
            clicked => { root.list-open = !root.list-open; }
        }
        if root.list-open: TouchArea { clicked => { root.list-open = false; } }
        if root.list-open: Rectangle {
            x: parent.width - self.width - 8px;
            y: Math.max(8px, parent.height - self.height - 44px);
            width: Math.min(240px, parent.width - 16px);
            height: Math.min(220px, parent.height - 60px);
            background: CallTokens.raised;
            border-width: 1px;
            border-color: CallTokens.line;
            border-radius: 8px;
            TouchArea { }
            VerticalLayout {
                padding: 8px;
                spacing: 6px;
                HorizontalLayout {
                    Text { text: "额外成员"; color: CallTokens.dim; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; }
                    CallButton { width: 28px; height: 28px; icon: @image-url("call/icons/close.svg"); accessible-label: "关闭额外成员名单"; init => { self.focus(); } clicked => { root.list-open = false; } }
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 3px;
                        alignment: start;
                        for person in root.waiting: CallButton {
                            height: 32px;
                            label: person.name + (!root.stale && person.speaking ? " · 说话中" : person.deafened ? " · 关闭声音" : person.muted ? " · 闭麦" : "");
                            clicked => { root.list-open = false; root.open-member(person.id); }
                        }
                    }
                }
            }
        }
    }
}
