// SPDX-License-Identifier: GPL-3.0-or-later

import { Theme, Btn, Field, Dot, LevelBar } from "theme.slint";
import { ScrollView, Slider, ComboBox } from "std-widgets.slint";
import { Campfire, Seat } from "campfire.slint";
export { Seat }

// 频道树和成员名单压成的一行。
//
// 用一个扁平列表而不是嵌套模型：频道和人本来就是交替出现的，
// 嵌套两层模型换不来任何东西，却要在 Rust 那边维护两套同步逻辑。
export struct Row {
    is-channel: bool,
    id: int,
    name: string,
    depth: int,
    // 下面几个只对人有意义
    muted: bool,
    deafened: bool,
    speaking: bool,
    is-me: bool,
    // 只对频道有意义：我在不在这个频道里
    is-current: bool,
    // 频道里有几个人，显示在右边
    count: int,
    // 只对频道有意义：我能不能删它。**这只决定画不画那个 ×**，
    // 真正说了算的是服务端 —— 画错了最多是一个点了没反应的按钮。
    can-delete: bool,
    // 只对人有意义：我给这个人单独调的音量，百分比。100 是原样，0 是静音。
    volume: int,
    // 只对人有意义：角色，协议里的数值（1 访客 2 成员 3 频道管理 4 管理员）。
    role: int,
    // 我能对这个人做什么 / 能不能改这个频道。**只决定画不画按钮**，
    // 说了算的是服务端。
    can-kick: bool,
    can-ban: bool,
    can-set-role: bool,
    can-edit: bool,
}

/// 封禁名单里的一条。
export struct BanRow {
    name: string,
    /// 什么时候、谁封的、为什么，拼好的一行。
    detail: string,
    /// 公钥的 base32。解封时原样传回去。
    key: string,
}

/// 一次麦克风检测的结果。
export struct ScanRow {
    name: string,
    verdict: string,
    /// 真的收到人声了。
    ok: bool,
    /// WASAPI 的设备 id。
    ///
    /// **带 id 而不是下拉框里的序号**：序号要靠两次列举的顺序一致才对得上，
    /// 对不上就会悄悄选中别的设备 —— 用户点了 A 结果用上了 B，
    /// 而界面上什么都不会说。
    id: string,
}

export struct ChatRow {
    sender: string,
    body: string,
    time: string,
    is-me: bool,
}

// 托盘图标。一直在，程序开着就在。
//
// 三种样子：没连着（灰）、在频道里开着麦（橙）、在频道里闭着麦（橙 + 红斜杠）。
// 收到托盘之后，用户唯一能看到的就是这个图标 —— 它必须一眼说清楚「我现在是不是在
// 往频道里放声音」，不然有人以为关掉了，其实一直开着麦。
//
// 左键点图标回到窗口，右键出菜单。
export component Tray inherits SystemTrayIcon {
    /// 0 没连着，1 在频道里开着麦，2 在频道里闭着麦（或者关着耳朵）。
    in property <int> state: 0;
    in property <string> status;
    in property <bool> connected: false;
    in property <bool> muted: false;
    in property <bool> deafened: false;

    icon: root.state == 1 ? @image-url("icons/flame.svg")
        : root.state == 2 ? @image-url("icons/tray-muted.svg")
        : @image-url("icons/tray-off.svg");
    tooltip: root.status;

    callback show-window();
    callback toggle-mute();
    callback toggle-deafen();
    callback leave();
    callback quit();

    clicked => { root.show-window(); }

    Menu {
        MenuItem {
            title: "显示篝火";
            activated => { root.show-window(); }
        }
        MenuSeparator {}
        MenuItem {
            title: root.muted ? "开麦" : "闭麦";
            enabled: root.connected;
            activated => { root.toggle-mute(); }
        }
        MenuItem {
            title: root.deafened ? "打开耳朵" : "关耳朵";
            enabled: root.connected;
            activated => { root.toggle-deafen(); }
        }
        MenuItem {
            title: "离开频道";
            enabled: root.connected;
            activated => { root.leave(); }
        }
        MenuSeparator {}
        MenuItem {
            title: "退出篝火";
            activated => { root.quit(); }
        }
    }
}

/// 「有新版本」那一条。不挡着什么，点 × 这次就不再提。
component UpdateBar inherits Rectangle {
    in property <string> version;
    callback open();
    callback dismiss();

    background: #1d2330;
    border-radius: Theme.radius;
    HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 8px;
        Text {
            text: "篝火有新版本了：" + root.version;
            color: Theme.text;
            font-size: 13px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            wrap: word-wrap;
        }
        Btn {
            width: 72px;
            label: "去下载";
            primary: true;
            clicked => { root.open(); }
        }
        Btn {
            width: 36px;
            label: "×";
            accessible-label: "这次不提了";
            clicked => { root.dismiss(); }
        }
    }
}

export component App inherits Window {
    title: "篝火";
    icon: @image-url("icons/flame.svg");
    background: Theme.bg;
    default-font-family: Theme.font;
    // 挂在游戏旁边用的，要能缩得很小。窄到放不下左边的频道树时，
    // 频道树收起来，用左上角的「频道」叫出来（见 narrow）。
    min-width: 400px;
    min-height: 360px;
    preferred-width: 760px;
    preferred-height: 520px;

    /// 窗口窄到左边频道树和篝火并排放不下。这时两个只显示一个。
    property <bool> narrow: root.width < 640px;
    /// 窄窗口时：现在显示的是不是频道树。
    property <bool> tree-open: false;

    // ---- 状态 ----
    in-out property <bool> connected: false;
    in-out property <bool> connecting: false;
    in-out property <string> invite-link;
    in-out property <string> nick;
    in property <string> error-headline;
    in property <string> error-advice;

    in property <string> server-name: "篝火";
    in property <string> my-fingerprint;
    in property <[Row]> rows;
    in property <[ChatRow]> chat;
    /// 篝火：固定 8 条，第 n 条是 n 号座位。见 campfire.slint。
    in property <[Seat]> seats;
    /// 座位满了之后来的人。
    in property <[Seat]> waiting;
    in property <bool> waiting-talking: false;
    /// 我所在的频道叫什么，篝火上面那一栏显示。
    in property <string> channel-name;
    /// 篝火的像素底图，Rust 那边按画面大小画好。
    in property <image> campfire-backdrop;
    /// 篝火画面大小变了，要重画底图和石头。
    callback campfire-resized(length, length);
    /// 篝火现在是不是摆在眼前（不是在看文字聊天、设置、窄窗口下的频道树）。
    /// Rust 那边看它决定火要不要动 —— 看不见的火一帧都不画。
    out property <bool> campfire-shown: root.connected && !root.show-settings && !root.chat-open
        && !(root.narrow && root.tree-open);
    /// 右边显示文字聊天还是篝火。纯界面状态。
    in-out property <bool> chat-open: false;
    /// 上次看聊天时有几条，用来判断有没有没看过的。
    ///
    /// 按条数比，所以聊天记录攒满（client-core 的 MAX_CHAT_LINES）以后
    /// 新消息就不提示了。一次开黑攒不到两百条，先这样。
    property <int> chat-seen: 0;
    changed chat => {
        if (root.chat-open) {
            root.chat-seen = root.chat.length;
        }
    }
    in-out property <string> draft;
    in-out property <bool> self-muted: false;
    in-out property <bool> self-deafened: false;
    // UDP 通不通。不通的时候要让用户看见，而不是让他纳闷为什么没声音。
    in property <bool> udp-ok: false;
    // 语音那边出的错（设备打不开、采样率不对）。要能直接显示给用户。
    in property <string> voice-error;
    // 连接断了、正在自己重连时的说明。空表示没在重连。
    //
    // 重连期间**留在频道界面上**，不退回登录页：名单保持断之前的样子，
    // 顶上一条说明加一个取消按钮。退回登录页的话，网络抖一下用户就以为
    // 自己被踢了，而且会下意识去点「加入」—— 那恰恰是不用做的事。
    in property <string> reconnecting;

    // ---- 设置 ----
    in-out property <bool> show-settings: false;
    in-out property <bool> ptt-mode: false;
    /// 按住说话绑的键，给人看的名字。空表示还没绑。
    in property <string> ptt-label;
    /// 正在等用户按一个键。
    in property <bool> rebinding: false;

    // ---- 麦克风 ----
    /// 麦克风电平，已经从分贝映射成 0–1。
    in property <float> input-level;
    /// 语音激活的阈值，同一把尺子。
    in-out property <float> vad-level;
    /// 现在在不在往外发。
    in property <bool> transmitting: false;
    in property <bool> monitoring: false;
    /// 设备下拉框的内容，第 0 项永远是「系统默认」。
    in property <[string]> capture-devices;
    in property <[string]> render-devices;
    in-out property <int> capture-index: 0;
    in-out property <int> render-index: 0;
    /// 实际打开的那个采集设备叫什么。可能跟选的不一样（选的那个没了）。
    in property <string> capture-in-use;
    /// 实际用的是不是虚拟声卡。是的话要提醒 —— 没在路由的虚拟麦是纯静音的。
    in property <bool> capture-is-virtual: false;
    /// 我能不能建频道（访客不能）。决定显不显示列表底部那一行。
    in property <bool> can-create-channel: false;
    /// 「新建频道」那一行有没有展开成输入框。纯界面状态，不出这个文件。
    property <bool> newchan-open: false;
    property <string> newchan-name;
    /// 展开了音量滑条的那个人的会话 id。-1 表示都收着。纯界面状态。
    property <int> volume-open: -1;
    /// 点了一次「封禁」、等第二次确认的那个人。-1 表示没有。
    property <int> ban-armed: -1;
    /// 正在改名的频道。-1 表示没有。
    property <int> renaming: -1;
    property <string> rename-draft;
    /// 我是不是管理员。决定显不显示封禁名单。
    in property <bool> is-admin: false;
    in property <[BanRow]> bans;
    property <bool> bans-open: false;
    /// 正在挨个试麦克风。
    in property <bool> scanning: false;
    in property <[ScanRow]> scan-results;

    // ---- 进出提示 ----
    in-out property <bool> cue-sounds: true;
    in-out property <bool> announce-names: false;
    /// 提示音和念名字的音量，0–1。
    in-out property <float> cue-volume: 0.6;

    // ---- 回调 ----
    callback join();
    callback leave();
    callback join-channel(int);
    /// 建频道。参数是频道名，界面这边已经 trim 过并挡掉了空串。
    callback create-channel(string);
    callback delete-channel(int);
    /// 单独调某个人的音量：(会话 id, 滑条上的原始值)。取整和吸附在 Rust 那边做。
    callback set-user-volume(int, float);
    /// 拖完了，存盘。拖动过程中不存 —— 一次拖动会触发几十次 changed。
    callback save-user-volumes();
    callback rename-channel(int, string);
    callback kick-user(int);
    callback ban-user(int);
    /// (会话 id, 角色在下拉框里的序号：0 访客 1 成员 2 频道管理 3 管理员)
    callback set-role(int, int);
    /// 参数是公钥的 base32，见 BanRow.key。
    callback unban(string);
    callback send-text();
    callback toggle-mute();
    callback toggle-deafen();
    callback toggle-settings();
    callback set-ptt-mode(bool);
    callback rebind-ptt();
    callback cancel-rebind();
    callback toggle-monitor();
    callback set-vad(float);
    callback pick-capture(int);
    callback pick-render(int);
    callback scan-microphones();
    callback pick-capture-id(string);
    callback set-cue-sounds(bool);
    callback set-announce-names(bool);
    callback set-cue-volume(float);
    /// 音量滑条拖完了，存盘。
    callback save-cue-volume();
    /// 照着「阿狸进来了」的样子响一遍，调音量用。
    callback preview-cues();

    // ---- 更新 ----
    /// 有新版本时是它的版本号，没有是空的。
    in-out property <string> update-version;
    callback open-update();
    in-out property <bool> check-updates: true;
    callback set-check-updates(bool);

    // ---- 关闭 ----
    /// 点 × 时怎么办：0 每次问，1 收到托盘，2 退出。
    in-out property <int> close-action: 0;
    callback set-close-action(int);
    /// 正在问「收到托盘还是退出」。
    in-out property <bool> close-prompt: false;
    /// 问的时候说「你还在哪个频道里」。
    in property <string> close-prompt-channel;
    property <bool> close-remember: false;
    /// (收到托盘？, 记住这个选择？)
    callback close-choice(bool, bool);

    // =======================================================================
    // 没连上：一个框，一个按钮
    // =======================================================================
    if !root.connected && !root.show-settings: VerticalLayout {
        alignment: center;
        padding: 48px;

        VerticalLayout {
            spacing: 18px;
            max-width: 460px;
            alignment: center;

            Text {
                text: "篝火";
                color: Theme.text;
                font-size: 30px;
                font-weight: 600;
                horizontal-alignment: center;
            }
            Text {
                text: "把朋友发给你的那条链接粘进来";
                color: Theme.dim;
                font-size: 14px;
                horizontal-alignment: center;
            }

            VerticalLayout {
                spacing: 10px;
                link := Field {
                    placeholder: "gouhuo://j/…";
                    text <=> root.invite-link;
                    accepted => { root.join(); }
                }
                Field {
                    placeholder: "你的昵称";
                    text <=> root.nick;
                    accepted => { root.join(); }
                }
                Btn {
                    label: root.connecting ? "正在连接…" : "加入";
                    primary: true;
                    enabled: !root.connecting && root.invite-link != "";
                    clicked => { root.join(); }
                }
            }

            // 报错要占住位置一起显示，别用弹窗 —— 弹窗一关，用户就想不起来
            // 刚才说了什么，而这几行恰恰是要照着做的。
            if root.error-headline != "": Rectangle {
                background: #2a1d1d;
                border-radius: Theme.radius;
                border-width: 1px;
                border-color: #4a2b28;

                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    Text {
                        text: root.error-headline;
                        color: Theme.danger;
                        font-size: 14px;
                        font-weight: 600;
                        wrap: word-wrap;
                    }
                    Text {
                        text: root.error-advice;
                        color: Theme.dim;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                }
            }

            if root.update-version != "": UpdateBar {
                version: root.update-version;
                open => { root.open-update(); }
                dismiss => { root.update-version = ""; }
            }

            // 连不上的时候最想确认的就是「是不是我麦克风的问题」，
            // 所以这个入口必须在登录页上就有。
            Btn {
                label: "先试试麦克风";
                clicked => { root.toggle-settings(); }
            }

            if root.my-fingerprint != "": Text {
                text: "你的身份指纹 " + root.my-fingerprint;
                color: Theme.faint;
                font-size: 11px;
                horizontal-alignment: center;
            }
        }
    }

    // =======================================================================
    // 连上了：左边频道树，右边文字
    // =======================================================================
    if root.connected && !root.show-settings: HorizontalLayout {
        spacing: 0;

        // ---- 左：频道树 + 成员 ----
        if !root.narrow || root.tree-open: Rectangle {
            width: root.narrow ? root.width : 260px;
            background: Theme.panel;

            VerticalLayout {
                padding: 0;

                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: 8px;
                        Text {
                            text: root.server-name;
                            color: Theme.text;
                            font-size: 15px;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // 窄窗口时频道树占满整个窗口，这里回到篝火
                        if root.narrow: Btn {
                            width: 56px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            label: "篝火";
                            clicked => { root.tree-open = false; }
                        }
                        Btn {
                            width: 34px;
                            height: 28px;
                            y: (parent.height - self.height) / 2;
                            label: "⚙";
                            clicked => { root.toggle-settings(); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }


                ScrollView {
                    VerticalLayout {
                        padding: 6px;
                        spacing: 1px;

                        for row[i] in root.rows: VerticalLayout {
                          if row.is-channel && root.renaming == row.id: HorizontalLayout {
                              padding-left: 4px + (row.depth * 12px);
                              spacing: 4px;
                              Field {
                                  height: 30px;
                                  init => { self.focus(); }
                                  text <=> root.rename-draft;
                                  horizontal-stretch: 1;
                                  accepted => {
                                      if (root.rename-draft != "") {
                                          root.rename-channel(row.id, root.rename-draft);
                                      }
                                      root.renaming = -1;
                                  }
                              }
                              Btn {
                                  width: 30px;
                                  height: 30px;
                                  label: "✕";
                                  clicked => { root.renaming = -1; }
                              }
                          }

                          if !(row.is-channel && root.renaming == row.id): Rectangle {
                            height: row.is-channel ? 30px : 28px;
                            border-radius: 6px;
                            background: row.is-channel && row.is-current
                                ? Theme.raised
                                : (rowtouch.has-hover && row.is-channel ? Theme.hover : transparent);
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 8px + (row.depth * 12px);
                                padding-right: 10px;
                                spacing: 8px;

                                if !row.is-channel: Dot {
                                    y: (parent.height - self.height) / 2;
                                    // 正在说话压过静音状态：一个人可能自己没闭麦
                                    // 但别人也没听见，那种时候「他在说话」更有用。
                                    tint: row.speaking
                                        ? Theme.speaking
                                        : (row.deafened
                                            ? Theme.danger
                                            : (row.muted ? Theme.warn : Theme.faint));
                                    // 说话时那个点要看得出来在动
                                    width: row.speaking ? 10px : 8px;
                                    height: self.width;
                                    border-radius: self.width / 2;
                                    animate width { duration: 100ms; }
                                }

                                Text {
                                    text: row.is-channel ? row.name : "  " + row.name;
                                    color: row.is-channel
                                        ? (row.is-current ? Theme.text : Theme.dim)
                                        : (row.is-me ? Theme.accent : Theme.text);
                                    font-size: row.is-channel ? 13px : 14px;
                                    font-weight: row.is-channel ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                // 频道管理和管理员标一下：要知道该找谁处理问题。
                                if !row.is-channel && row.role >= 3: Text {
                                    text: row.role >= 4 ? "管理员" : "频道管理";
                                    color: Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                // 调过音量的人在右边标一下。不标的话，一个被自己调成 0
                                // 的人说话时点在闪却听不见，用户只会以为是他麦克风坏了。
                                if !row.is-channel && !row.is-me && row.volume != 100: Text {
                                    text: row.volume == 0 ? "已静音" : row.volume + "%";
                                    color: row.volume == 0 ? Theme.warn : Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: center;
                                }

                                if row.is-channel && !((row.can-delete || row.can-edit) && rowtouch.has-hover): Text {
                                    text: row.count > 0 ? row.count : "";
                                    color: Theme.faint;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                // 改名。跟删除一样，只在鼠标移上来时才出现。
                                if row.is-channel && row.can-edit && rowtouch.has-hover: Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: edithover.has-hover ? Theme.hover : transparent;

                                    Text {
                                        text: "✎";
                                        color: edithover.has-hover ? Theme.text : Theme.faint;
                                        font-size: 13px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    edithover := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.rename-draft = row.name;
                                            root.renaming = row.id;
                                        }
                                    }
                                }

                                // 删频道。**只在鼠标移上来时才出现** ——
                                // 常驻的话每一行都挂一个红叉，而删频道是低频且
                                // 不可逆的操作，不该长期占着视觉位置。
                                if row.is-channel && row.can-delete && rowtouch.has-hover: Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 4px;
                                    background: delhover.has-hover ? Theme.danger : transparent;
                                    animate background { duration: 100ms; }

                                    Text {
                                        text: "×";
                                        color: delhover.has-hover ? Theme.text : Theme.faint;
                                        font-size: 15px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        width: 100%;
                                        height: 100%;
                                    }

                                    delhover := TouchArea {
                                        mouse-cursor: pointer;
                                        // 别让这一下顺手把频道也切了 —— TouchArea
                                        // 会吃掉事件，不会透到下面的 rowtouch。
                                        clicked => { root.delete-channel(row.id); }
                                    }
                                }
                            }

                            // 点频道是进去；点别人是展开 / 收起他的音量滑条。
                            // 点自己没有反应 —— 自己的音量在底部那两个按钮上。
                            rowtouch := TouchArea {
                                enabled: row.is-channel || !row.is-me;
                                mouse-cursor: pointer;
                                clicked => {
                                    if (row.is-channel) {
                                        root.join-channel(row.id);
                                        root.tree-open = false;
                                    } else {
                                        volume-open = volume-open == row.id ? -1 : row.id;
                                    }
                                }
                            }
                          }

                          if !row.is-channel && !row.is-me && root.volume-open == row.id: HorizontalLayout {
                              height: 34px;
                              padding-left: 8px + (row.depth * 12px) + 16px;
                              padding-right: 10px;
                              spacing: 8px;

                              vol := Slider {
                                  minimum: 0;
                                  maximum: 400;
                                  value: row.volume;
                                  horizontal-stretch: 1;
                                  changed(v) => { root.set-user-volume(row.id, v); }
                                  released(v) => { root.save-user-volumes(); }
                              }
                              Text {
                                  text: row.volume + "%";
                                  color: Theme.dim;
                                  font-size: 12px;
                                  width: 40px;
                                  horizontal-alignment: right;
                                  vertical-alignment: center;
                              }
                              Btn {
                                  width: 52px;
                                  height: 26px;
                                  y: (parent.height - self.height) / 2;
                                  label: row.volume == 0 ? "恢复" : "静音";
                                  clicked => {
                                      // 滑条被拖过之后，它的 value 就不再跟着 row.volume 走了
                                      // （Slint 里赋值会打断绑定），所以这里要亲手把它拨过去。
                                      vol.value = row.volume == 0 ? 100 : 0;
                                      root.set-user-volume(row.id, vol.value);
                                      root.save-user-volumes();
                                  }
                              }
                          }

                          // 管理操作。没有任何权限的人看不到这一行。
                          if !row.is-channel && !row.is-me && root.volume-open == row.id
                              && (row.can-kick || row.can-ban || row.can-set-role): HorizontalLayout {
                              height: 34px;
                              padding-left: 8px + (row.depth * 12px) + 16px;
                              padding-right: 10px;
                              spacing: 6px;

                              if row.can-set-role: ComboBox {
                                  horizontal-stretch: 1;
                                  model: ["访客", "成员", "频道管理", "管理员"];
                                  current-index: row.role - 1;
                                  selected(v) => { root.set-role(row.id, self.current-index); }
                              }
                              if !row.can-set-role: Rectangle { horizontal-stretch: 1; }
                              if row.can-kick: Btn {
                                  width: 52px;
                                  height: 26px;
                                  y: (parent.height - self.height) / 2;
                                  label: "踢出";
                                  clicked => { root.kick-user(row.id); }
                              }
                              // 封禁要点两下：第一下只是「武装」，按钮变成红色的「确认封禁」。
                              // 封禁虽然能解，但被封的人那边是立刻断线的，手滑的代价太大。
                              if row.can-ban: Btn {
                                  width: root.ban-armed == row.id ? 76px : 52px;
                                  height: 26px;
                                  y: (parent.height - self.height) / 2;
                                  label: root.ban-armed == row.id ? "确认封禁" : "封禁";
                                  primary: root.ban-armed == row.id;
                                  clicked => {
                                      if (root.ban-armed == row.id) {
                                          root.ban-armed = -1;
                                          root.ban-user(row.id);
                                      } else {
                                          root.ban-armed = row.id;
                                      }
                                  }
                              }
                          }
                        }

                        // ---- 新建频道 ----
                        //
                        // 平时只是一行浅色的「＋ 新建频道」，点了才变成输入框。
                        // 常驻一个输入框的话，一个低频操作会一直占着列表底部，
                        // 而这个列表的主角是频道和人。
                        if root.can-create-channel && !newchan-open: Rectangle {
                            height: 30px;
                            border-radius: 6px;
                            background: newchan-touch.has-hover ? Theme.hover : transparent;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 10px;
                                Text {
                                    text: "＋ 新建频道";
                                    color: newchan-touch.has-hover ? Theme.dim : Theme.faint;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                }
                            }

                            newchan-touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    newchan-open = true;
                                    newchan-name = "";
                                }
                            }
                        }

                        if root.can-create-channel && newchan-open: HorizontalLayout {
                            padding-top: 2px;
                            spacing: 4px;

                            Field {
                                height: 30px;
                                placeholder: "频道名";
                                // 展开的那一刻就把光标放进去 —— 点了「＋」还要
                                // 再点一次输入框是多余的一步。
                                //
                                // 聚焦写在这里而不是「＋」的 clicked 里：那两个
                                // 分支互相看不见对方的 id（Slint 的 if 各自成域），
                                // 而这个组件正好是在展开时才被创建的。
                                init => { self.focus(); }
                                text <=> newchan-name;
                                horizontal-stretch: 1;
                                accepted => {
                                    // 空名字不发。服务端也会拒，但让它连发都不发
                                    // 更干脆 —— 用户按回车没反应就知道还没填。
                                    if (newchan-name != "") {
                                        root.create-channel(newchan-name);
                                        newchan-name = "";
                                        newchan-open = false;
                                    }
                                }
                            }
                            Btn {
                                width: 30px;
                                height: 30px;
                                label: "✕";
                                clicked => {
                                    newchan-open = false;
                                    newchan-name = "";
                                }
                            }
                        }
                    }
                }

                // ---- 封禁名单：只有管理员看得到，平时收着 ----
                if root.is-admin && root.bans.length > 0: Rectangle {
                    height: 30px;
                    background: banstouch.has-hover ? Theme.hover : transparent;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 10px;
                        Text {
                            text: (root.bans-open ? "▾ " : "▸ ") + "封禁名单（" + root.bans.length + "）";
                            color: Theme.faint;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                    banstouch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.bans-open = !root.bans-open; }
                    }
                }
                if root.is-admin && root.bans-open: VerticalLayout {
                    padding-left: 14px;
                    padding-right: 10px;
                    padding-bottom: 6px;
                    spacing: 4px;
                    for ban in root.bans: HorizontalLayout {
                        spacing: 6px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: ban.name;
                                color: Theme.text;
                                font-size: 12px;
                                overflow: elide;
                            }
                            Text {
                                text: ban.detail;
                                color: Theme.faint;
                                font-size: 11px;
                                overflow: elide;
                            }
                        }
                        Btn {
                            width: 52px;
                            height: 26px;
                            y: (parent.height - self.height) / 2;
                            label: "解封";
                            clicked => { root.unban(ban.key); }
                        }
                    }
                }

                // ---- 自己的那一条，钉在底部 ----
                Rectangle { height: 1px; background: Theme.line; }
                Rectangle {
                    height: 56px;
                    background: Theme.bg;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;

                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            Text {
                                text: root.nick;
                                color: Theme.text;
                                font-size: 13px;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 5px;
                                Dot {
                                    y: 4px;
                                    tint: root.udp-ok && root.reconnecting == "" ? Theme.speaking : Theme.warn;
                                }
                                Text {
                                    text: root.reconnecting != ""
                                        ? "正在重连…"
                                        : root.voice-error != ""
                                        ? "语音出错"
                                        : (!root.udp-ok
                                            ? "语音连接中…"
                                            : (root.ptt-mode
                                                ? (root.ptt-label == ""
                                                    ? "没绑说话键"
                                                    : "按住 " + root.ptt-label + " 说话")
                                                : "语音激活"));
                                    color: root.voice-error != "" ? Theme.danger : Theme.faint;
                                    font-size: 11px;
                                    overflow: elide;
                                }
                            }
                        }

                        Btn {
                            width: 44px;
                            y: (parent.height - self.height) / 2;
                            label: root.self-muted ? "🔇" : "🎤";
                            clicked => { root.toggle-mute(); }
                        }
                        Btn {
                            width: 44px;
                            y: (parent.height - self.height) / 2;
                            label: root.self-deafened ? "🔕" : "🔊";
                            clicked => { root.toggle-deafen(); }
                        }
                    }
                }
            }
        }

        if !root.narrow: Rectangle { width: 1px; background: Theme.line; }

        // ---- 右：篝火，或者文字聊天 ----
        if !root.narrow || !root.tree-open: Rectangle {
            background: Theme.bg;
            horizontal-stretch: 1;

            VerticalLayout {
                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: 8px;
                        // 不用「☰」：雅黑里没有这个字，画出来是个方框
                        if root.narrow: Btn {
                            width: 52px;
                            y: (parent.height - self.height) / 2;
                            label: "频道";
                            clicked => { root.tree-open = true; }
                        }
                        Text {
                            text: root.chat-open ? "频道文字" : root.channel-name;
                            color: Theme.dim;
                            font-size: 13px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // 窄窗口时左下角那一条（闭麦、关耳朵）跟着频道树收起来了，搬到这里
                        if root.narrow: Btn {
                            width: 40px;
                            y: (parent.height - self.height) / 2;
                            label: root.self-muted ? "🔇" : "🎤";
                            clicked => { root.toggle-mute(); }
                        }
                        if root.narrow: Btn {
                            width: 40px;
                            y: (parent.height - self.height) / 2;
                            label: root.self-deafened ? "🔕" : "🔊";
                            clicked => { root.toggle-deafen(); }
                        }
                        // 篝火和文字来回切。有没看过的消息时按钮上亮个点 ——
                        // 看着篝火的时候，别人发的链接不能就这么错过了。
                        Rectangle {
                            width: root.narrow ? 56px : 72px;
                            height: 36px;
                            y: (parent.height - self.height) / 2;
                            Btn {
                                width: 100%;
                                label: root.chat-open ? "篝火" : "文字";
                                clicked => {
                                    root.chat-open = !root.chat-open;
                                    root.chat-seen = root.chat.length;
                                }
                            }
                            if !root.chat-open && root.chat.length > root.chat-seen: Rectangle {
                                x: parent.width - 12px;
                                y: 4px;
                                width: 8px;
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.accent;
                            }
                        }
                        Btn {
                            width: root.narrow ? 56px : 72px;
                            y: (parent.height - self.height) / 2;
                            label: "离开";
                            clicked => { root.leave(); }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.line; }

                if root.update-version != "": UpdateBar {
                    version: root.update-version;
                    open => { root.open-update(); }
                    dismiss => { root.update-version = ""; }
                }

                if root.reconnecting != "": Rectangle {
                    background: #2a251a;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Text {
                            text: root.reconnecting;
                            color: Theme.warn;
                            font-size: 12px;
                            wrap: word-wrap;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                        Btn {
                            width: 64px;
                            label: "取消";
                            clicked => { root.leave(); }
                        }
                    }
                }

                // 语音出错要占住位置一起显示。麦克风没声音的时候，用户第一件
                // 想知道的就是「为什么」，而弹窗一关就没了。
                if root.voice-error != "" && root.reconnecting == "": Rectangle {
                    background: #2a1d1d;
                    VerticalLayout {
                        padding: 12px;
                        Text {
                            text: root.voice-error;
                            color: Theme.danger;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                if !root.chat-open: Campfire {
                    vertical-stretch: 1;
                    seats: root.seats;
                    waiting: root.waiting;
                    waiting-talking: root.waiting-talking;
                    transmitting: root.transmitting;
                    backdrop: root.campfire-backdrop;
                    resized(w, h) => { root.campfire-resized(w, h); }
                    set-volume(id, v) => { root.set-user-volume(id, v); }
                    save-volumes => { root.save-user-volumes(); }
                    kick(id) => { root.kick-user(id); }
                    ban(id) => { root.ban-user(id); }
                    set-role(id, index) => { root.set-role(id, index); }
                }

                if root.chat-open: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        padding: Theme.pad;
                        spacing: 10px;
                        alignment: start;

                        if root.chat.length == 0: Text {
                            text: "这里的消息关掉就没了 —— 发个链接、报个坐标用的，不留记录。";
                            color: Theme.faint;
                            font-size: 12px;
                            wrap: word-wrap;
                        }

                        for line[i] in root.chat: VerticalLayout {
                            spacing: 3px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: line.sender;
                                    color: line.is-me ? Theme.accent : Theme.text;
                                    font-size: 13px;
                                    font-weight: 600;
                                }
                                Text {
                                    text: line.time;
                                    color: Theme.faint;
                                    font-size: 11px;
                                    vertical-alignment: bottom;
                                }
                            }
                            Text {
                                text: line.body;
                                color: Theme.text;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                if root.chat-open: Rectangle {
                    height: 60px;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;
                        Field {
                            placeholder: "说点什么";
                            text <=> root.draft;
                            horizontal-stretch: 1;
                            accepted => { root.send-text(); }
                        }
                        Btn {
                            width: 64px;
                            label: "发送";
                            primary: true;
                            enabled: root.draft != "";
                            clicked => { root.send-text(); }
                        }
                    }
                }
            }
        }
    }
    // =======================================================================
    // 设置。**连不连服务器都能开** —— 「我的麦克风好不好使」这个问题，
    // 恰恰在连不上的时候最想知道：是我麦克风坏了，还是服务器的问题？
    // =======================================================================
    if root.show-settings: VerticalLayout {
        Rectangle {
            height: 52px;
            background: Theme.panel;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                spacing: 8px;
                Btn {
                    width: 40px;
                    y: (parent.height - self.height) / 2;
                    label: "←";
                    clicked => { root.toggle-settings(); }
                }
                Text {
                    text: "设置";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        ScrollView {
            vertical-stretch: 1;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    // 设备名字很长，260px 的侧栏里挤得没法看。
                    width: 460px;
                VerticalLayout {
                    padding: Theme.pad;
                    spacing: 14px;
                    alignment: start;

                    Text {
                        text: "说话方式";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Btn {
                            label: "语音激活";
                            primary: !root.ptt-mode;
                            clicked => { root.set-ptt-mode(false); }
                        }
                        Btn {
                            label: "按住说话";
                            primary: root.ptt-mode;
                            clicked => { root.set-ptt-mode(true); }
                        }
                    }

                    Text {
                        text: "按住说话的键";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    Btn {
                        label: root.rebinding
                            ? "按一个键…（点这里取消）"
                            : (root.ptt-label == "" ? "还没设置，点这里设" : root.ptt-label);
                        primary: root.rebinding;
                        clicked => {
                            if (root.rebinding) { root.cancel-rebind(); }
                            else { root.rebind-ptt(); }
                        }
                    }
                    Text {
                        text: "键盘任意键，或者鼠标侧键。游戏全屏时也有效，"
                            + "而且不会把这个键从游戏那边抢走。";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Rectangle { height: 1px; background: Theme.line; }

                    // 设备出的错要**在这一页就看得见**。
                    //
                    // 第一版只在「已连接」那个界面里渲染它，于是设置页上设备打不开时
                    // 用户只看到一个闪一下就灭的麦克风灯，而原因明明已经拿到了。
                    if root.voice-error != "": Rectangle {
                        background: #2a1d1d;
                        border-radius: Theme.radius;
                        border-width: 1px;
                        border-color: #4a2b28;
                        VerticalLayout {
                            padding: 12px;
                            Text {
                                text: root.voice-error;
                                color: Theme.danger;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: "麦克风";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    ComboBox {
                        model: root.capture-devices;
                        current-index <=> root.capture-index;
                        selected(v) => { root.pick-capture(root.capture-index); }
                    }
                    // **始终显示现在真正打开的是哪个设备。**
                    //
                    // 「系统默认」到底是哪一个，用户是不知道的；而麦克风灯亮不亮、
                    // 是哪个设备的灯在亮，是他唯一的旁证。这一行把那个旁证坐实。
                    Text {
                        text: root.capture-in-use == ""
                            ? "正在打开设备…"
                            : "正在用：" + root.capture-in-use;
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    // 玩家机器上默认麦克风经常是 Sonar / Synapse 这类虚拟设备，
                    // 而它们没在路由的时候是纯静音的。必须说出来。
                    if root.capture-is-virtual: Text {
                        text: "这是个虚拟声卡。这类设备没在路由的时候是纯静音的，"
                            + "条子不动就换一个带「麦克风」字样的真设备试试。";
                        color: Theme.warn;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    LevelBar {
                        level: root.input-level;
                        threshold: root.vad-level;
                        active: root.transmitting;
                        show-threshold: !root.ptt-mode;
                    }
                    Text {
                        text: root.input-level < 0.02
                            ? "没收到声音。说句话看看条子动不动。"
                            : (root.ptt-mode
                                ? "按住说话键时才会发出去。"
                                : (root.transmitting
                                    ? "正在发送。"
                                    : "有声音，但没过竖线那道坎，所以没发出去。"));
                        color: root.input-level >= 0.02 && !root.transmitting && !root.ptt-mode
                            ? Theme.warn
                            : Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }
                    // 一键把每个麦克风都试一遍。用户对着一个下拉框是猜不出来哪个能用的，
                    // 而程序挨个试只要几秒。
                    Btn {
                        label: root.scanning
                            ? "正在挨个试…一直说话别停"
                            : "挨个试一遍，找出哪个麦克风能用";
                        primary: root.scanning;
                        enabled: !root.scanning;
                        clicked => { root.scan-microphones(); }
                    }

                    if root.scan-results.length > 0: VerticalLayout {
                        spacing: 4px;
                        for row[i] in root.scan-results: Rectangle {
                            height: 42px;
                            border-radius: 6px;
                            background: scantouch.has-hover ? Theme.hover : Theme.raised;
                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Dot {
                                    y: (parent.height - self.height) / 2;
                                    tint: row.ok ? Theme.speaking : Theme.faint;
                                }
                                VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text {
                                        text: row.name;
                                        color: row.ok ? Theme.text : Theme.dim;
                                        font-size: 12px;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.verdict;
                                        color: row.ok ? Theme.speaking : Theme.faint;
                                        font-size: 11px;
                                        overflow: elide;
                                    }
                                }
                            }
                            scantouch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.pick-capture-id(row.id); }
                            }
                        }
                        Text {
                            text: "点一行就选中那个设备。绿点表示检测时真的收到了人声。";
                            color: Theme.faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    // 条子一直不动的三个常见原因，按从常见到不常见排。
                    // 第三条最坑：Windows 的隐私设置挡掉麦克风时，
                    // 应用拿到的是**静音**而不是报错，看起来跟设备坏了一模一样。
                    if root.input-level < 0.02: Text {
                        text: "一直不动的话：换上面那个下拉框里别的设备试试；"
                            + "检查 Windows 音量合成器里这个麦克风有没有被静音；"
                            + "再看看「设置 → 隐私和安全性 → 麦克风」里有没有允许桌面应用访问 —— "
                            + "被挡住的时候拿到的是静音，跟设备坏了看起来一模一样。";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    if !root.ptt-mode: VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "语音激活的灵敏度";
                            color: Theme.faint;
                            font-size: 11px;
                        }
                        Slider {
                            minimum: 0;
                            maximum: 1;
                            value <=> root.vad-level;
                            changed(v) => { root.set-vad(v); }
                        }
                        Text {
                            text: "往左更灵敏（轻声也发），往右更迟钝（键盘声不会发出去）。";
                            color: Theme.faint;
                            font-size: 11px;
                            wrap: word-wrap;
                        }
                    }

                    Text {
                        text: "耳机 / 扬声器";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    ComboBox {
                        model: root.render-devices;
                        current-index <=> root.render-index;
                        selected(v) => { root.pick-render(root.render-index); }
                    }

                    Btn {
                        label: root.monitoring ? "停止试听" : "试听自己的麦";
                        primary: root.monitoring;
                        clicked => { root.toggle-monitor(); }
                    }
                    if root.monitoring: Rectangle {
                        background: #2a2417;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: "用扬声器试听会啸叫，戴耳机。听到的是直接回放，"
                                    + "别人听到的还会多过一道压缩。";
                                color: Theme.warn;
                                font-size: 11px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    Text {
                        text: "有人进出你所在的频道时";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Btn {
                            label: root.cue-sounds ? "提示音：开" : "提示音：关";
                            primary: root.cue-sounds;
                            clicked => { root.set-cue-sounds(!root.cue-sounds); }
                        }
                        Btn {
                            label: root.announce-names ? "念名字：开" : "念名字：关";
                            primary: root.announce-names;
                            clicked => { root.set-announce-names(!root.announce-names); }
                        }
                        Btn {
                            label: "试听";
                            clicked => { root.preview-cues(); }
                        }
                    }
                    Slider {
                        minimum: 0;
                        maximum: 1;
                        value <=> root.cue-volume;
                        changed(v) => { root.set-cue-volume(v); }
                        released(v) => { root.save-cue-volume(); }
                    }
                    Text {
                        text: "提示音和念名字的音量。隔壁频道有人进出不响；关了耳朵时也不响。";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    Text {
                        text: "点窗口的 × 时";
                        color: Theme.dim;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        Btn {
                            label: "每次问";
                            primary: root.close-action == 0;
                            clicked => { root.set-close-action(0); }
                        }
                        Btn {
                            label: "收到托盘";
                            primary: root.close-action == 1;
                            clicked => { root.set-close-action(1); }
                        }
                        Btn {
                            label: "退出";
                            primary: root.close-action == 2;
                            clicked => { root.set-close-action(2); }
                        }
                    }
                    Text {
                        text: "没连着服务器的时候点 × 总是直接退出。收到托盘之后，托盘图标上看得出麦克风开没开。";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        Btn {
                            label: root.check-updates ? "启动时检查更新：开" : "启动时检查更新：关";
                            primary: root.check-updates;
                            clicked => { root.set-check-updates(!root.check-updates); }
                        }
                    }
                    Text {
                        text: "只去 GitHub 看一眼最新的版本号，什么都不上传。有新版本就在窗口里提一句，不会自己下载、自己装。";
                        color: Theme.faint;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    // 选了按住说话却没绑键 = 一个字都发不出去。必须说出来。
                    if root.ptt-mode && root.ptt-label == "": Rectangle {
                        background: #2a2417;
                        border-radius: 6px;
                        VerticalLayout {
                            padding: 10px;
                            Text {
                                text: "还没绑键，现在谁都听不见你说话。";
                                color: Theme.warn;
                                font-size: 12px;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                }
            }
        }
    }

    // =======================================================================
    // 点了 ×，而且还在频道里：问一下是收到托盘还是退出
    // =======================================================================
    if root.close-prompt: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: #000000b0;

        // 吃掉点在遮罩上的点击，别漏到下面的界面去。
        TouchArea {}

        Rectangle {
            width: 380px;
            height: box.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.line;

            box := VerticalLayout {
                padding: 20px;
                spacing: 14px;

                Text {
                    text: "关闭篝火";
                    color: Theme.text;
                    font-size: 15px;
                    font-weight: 600;
                }
                Text {
                    text: "你还在「" + root.close-prompt-channel + "」里。";
                    color: Theme.dim;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Btn {
                        label: "收到托盘，继续在频道里";
                        primary: true;
                        clicked => { root.close-choice(true, root.close-remember); }
                    }
                    Btn {
                        label: "退出";
                        clicked => { root.close-choice(false, root.close-remember); }
                    }
                }
                // 自己画的勾选框：std-widgets 的 CheckBox 跟这套深色主题不搭。
                // 整行都能点，不用对准那个小方块。
                Rectangle {
                    height: 20px;
                    accessible-role: checkbox;
                    accessible-label: "记住我的选择";
                    accessible-checkable: true;
                    accessible-checked: root.close-remember;
                    accessible-action-default => { root.close-remember = !root.close-remember; }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle {
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: root.close-remember ? Theme.accent : Theme.faint;
                            background: root.close-remember ? Theme.accent : transparent;
                            Text {
                                text: root.close-remember ? "✓" : "";
                                color: Theme.text;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                        Text {
                            text: "记住我的选择（设置里能改）";
                            color: Theme.dim;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.close-remember = !root.close-remember; }
                    }
                }
            }
        }
    }
}
