import { Theme, Btn, Dot } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

export component UpdatePanel inherits VerticalLayout {
    in property <string> current-version;
    in property <string> latest-version;
    in property <int> status;
    in property <bool> checked;
    in property <string> error;
    in property <bool> automatic;
    callback check();
    callback details();
    callback set-automatic(bool);
    spacing: 16px;

    Rectangle {
        background: root.status == 3 ? #1e293b : Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: root.status == 3 ? #385782 : Theme.line;
        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            HorizontalLayout {
                spacing: 12px;
                Rectangle {
                    width: 44px;
                    height: 44px;
                    border-radius: 12px;
                    background: Theme.raised;
                    Image { x: 10px; y: 10px; width: 24px; height: 24px; source: @image-url("icons/flame.svg"); }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    Text { text: "篝火"; color: Theme.text; font-size: 18px; font-weight: 600; }
                    Text { text: "当前版本  v" + root.current-version; color: Theme.dim; font-size: 12px; }
                }
            }
            Rectangle { height: 1px; background: Theme.line; }
            HorizontalLayout {
                spacing: 10px;
                Dot {
                    y: 7px;
                    tint: root.status == 2 ? Theme.speaking : root.status == 4 ? Theme.warn : root.status == 0 ? Theme.dim : Theme.accent;
                }
                Text {
                    text: root.status == 1 ? "正在检查新版本…" : root.status == 2 ? "你已在使用最新版本" : root.status == 3 ? "新版本 v" + root.latest-version + " 已发布" : root.status == 4 ? "检查未完成" : "随时检查，保持最新";
                    color: Theme.text;
                    font-size: 16px;
                    font-weight: 600;
                    wrap: word-wrap;
                }
            }
            Text {
                text: root.status == 1 ? "正在连接更新服务，请稍候。" : root.status == 2 ? "已核对最新正式发布，暂时无需更新。" : root.status == 3 ? "查看版本发布说明，获取最新安装包。" : root.status == 4 ? "没有拿到版本信息，可以稍后再试。" : "点击下方按钮获取最新正式版本信息。";
                color: Theme.dim;
                font-size: 13px;
                wrap: word-wrap;
            }
            if root.status == 1: Rectangle {
                height: 4px;
                border-radius: 2px;
                background: Theme.raised;
                // Indeterminate: version checks have no measurable percentage.
                Rectangle {
                    width: parent.width * 0.28;
                    height: parent.height;
                    border-radius: 2px;
                    background: Theme.accent;
                    x: mod(animation-tick(), 1.6s) / 1.6s * (parent.width - self.width);
                }
            }
            if root.error != "": Text { text: root.error; color: Theme.warn; font-size: 12px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px;
                Btn {
                    label: root.status == 1 ? "检查中…" : root.status == 4 ? "重新检查" : "检查更新";
                    enabled: root.status != 1;
                    primary: root.status != 3;
                    clicked => { root.check(); }
                }
                if root.latest-version != "": Btn { label: "查看更新"; primary: true; clicked => { root.details(); } }
            }
            Text {
                text: root.checked ? "本次启动已成功检查版本" : "本次启动尚未完成版本检查";
                color: Theme.dim;
                font-size: 11px;
                wrap: word-wrap;
            }
        }
    }
    Rectangle {
        background: Theme.panel;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.line;
        VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text { text: "自动检查"; color: Theme.text; font-size: 15px; font-weight: 600; }
            Text { text: "启动时检查应用新版本，也允许声音内核在后台检查、下载并在空闲时切换。"; color: Theme.dim; font-size: 13px; wrap: word-wrap; }
            Btn {
                label: root.automatic ? "自动更新检查：已开启" : "自动更新检查：已关闭";
                primary: root.automatic;
                clicked => { root.set-automatic(!root.automatic); }
            }
        }
    }
    Text { text: "优先使用官方更新源，连接失败时尝试 GitHub。检查更新不会自动下载安装包；下载后请按发布说明完成安装。"; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
}

export component UpdateDialog inherits Rectangle {
    in property <string> current-version;
    in property <string> latest-version;
    in property <string> notes;
    in property <string> source;
    in property <bool> has-download;
    callback download();
    callback get-installer();
    callback dismiss();
    background: #000000b0;
    forward-focus: dialog-focus;
    init => { dialog-focus.focus(); }
    dialog-focus := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.dismiss(); return accept; }
            return reject;
        }
        TouchArea { clicked => { root.dismiss(); } }
        Rectangle {
            width: min(440px, root.width - 32px);
            height: min(root.height - 32px, 520px);
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.panel;
            border-radius: 16px;
            border-width: 1px;
            border-color: #385782;
            TouchArea {}
            content := VerticalLayout {
                padding: 24px;
                spacing: 16px;
                HorizontalLayout {
                    Text { text: "发现新版本"; color: Theme.text; font-size: 22px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    Btn { width: 36px; label: "×"; accessible-label: "关闭更新详情"; clicked => { root.dismiss(); } }
                }
                Rectangle {
                    height: 64px;
                    background: #1e293b;
                    border-radius: 8px;
                    HorizontalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text { text: "v" + root.current-version; color: Theme.dim; font-size: 16px; vertical-alignment: center; }
                        Text { text: "→"; color: Theme.dim; vertical-alignment: center; }
                        Text { text: "v" + root.latest-version; color: Theme.text; font-size: 20px; font-weight: 600; vertical-alignment: center; horizontal-stretch: 1; }
                    }
                }
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        Text { text: root.source == "" ? "更新说明" : "来源：" + root.source; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.notes == "" ? "请打开发布页查看更新说明。" : root.notes; color: Theme.text; font-size: 13px; wrap: word-wrap; }
                        Text { text: "下载后再安装；安装前请结束当前通话并退出篝火。"; color: Theme.dim; font-size: 12px; wrap: word-wrap; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    Btn { label: "稍后再说"; clicked => { root.dismiss(); } }
                    Btn { label: "发布说明"; primary: !root.has-download; clicked => { root.download(); } }
                    if root.has-download: Btn { label: "下载安装包"; primary: true; clicked => { root.get-installer(); } }
                }
            }
        }
    }
}
